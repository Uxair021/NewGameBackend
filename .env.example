PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/texasSlots
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (Vercel URL(s), localhost for dev)
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
STARTING_BALANCE=100
# Comma-separated emails auto-promoted to the admin role on register/login
ADMIN_EMAILS=admin@example.com

# Country block (admin dashboard). Free MaxMind account → GeoLite2 license key; with both set the
# server downloads the country database itself and keeps it updated.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Optional: database file location (default: data/GeoLite2-Country.mmdb)
# GEOIP_DB_PATH=
# Set to 1 if a reverse proxy sits in front of Node (so the real visitor IP is used); leave empty if not
TRUST_PROXY=
# Emergency: true turns the country block off whatever the dashboard says
GEOBLOCK_FORCE_OFF=false
